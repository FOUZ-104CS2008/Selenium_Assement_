package Day10_BaseClassImplementation;

import org.testng.annotations.Test;

import Day10_BaseClassUtility.BaseClass1;
import Day10_ExcelUtility.Utility;
import Day10_PomPages.CartPage;
import Day10_PomPages.CheckOutPage;
import Day10_PomPages.LoginPage;
import Day10_PomPages.ProductsPage;

public class SauceDemoTest extends BaseClass1 {

    @Test
    public void loginTest() throws Exception {
    	driver.get(p.getProperty("url"));
        String username = p.getProperty("username");
        String password = p.getProperty("password");
        LoginPage loginPage = new LoginPage(driver);
        loginPage.login(username, password);
        Thread.sleep(2000);
