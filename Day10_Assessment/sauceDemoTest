    }


    @Test
    public void orderPlacementTest() throws Exception {

        // Open application
        driver.get(p.getProperty("url"));

        // Login
        String username =  p.getProperty("username");        
        String password = p.getProperty("password");
               

        LoginPage loginPage =new LoginPage(driver);
        loginPage.login( username,password);
        Thread.sleep(2000);
        System.out.println("Login successful");
        // Products Page
        ProductsPage productsPage =new ProductsPage(driver);
        String actualTitle =productsPage.getProductsTitle();
        if (actualTitle.equals("Products")) {

            System.out.println("Products page is displayed");
        } 
        else {

            System.out.println( " Products page is not displayed");
                   
        }
        // Add Backpack
        productsPage.addBackpack();
        String cartCount = productsPage.getCartCount();
        if (cartCount.equals("1")) {

            System.out.println( "Cart contains 1 item");
        } 
        else {

            System.out.println("Cart does not contain 1 item");
                   
        }
        productsPage.clickCart();
        Thread.sleep(1000);


        // Cart Page
        CartPage cartPage =new CartPage(driver);
        String itemName = cartPage.getBackpackName();
        if (itemName.equals("Sauce Labs Backpack")) {
            System.out.println(" Sauce Labs Backpack is displayed");
        } 
        else {

            System.out.println("Sauce Labs Backpack is not displayed");
                    
        }


        // Checkout
        cartPage.clickCheckout();
        Thread.sleep(1000);

        // Excel Data
        String firstName =Utility.getData("Sheet1",1,0);
        String lastName =Utility.getData("Sheet1",1,1);
        String postalCode =Utility.getData("Sheet1",1,2);
        // Checkout Page
        CheckOutPage checkoutPage = new CheckOutPage(driver);
        checkoutPage.enterFirstName(firstName);
        checkoutPage.enterLastName(lastName);
        checkoutPage.enterPostalCode(postalCode);         
        checkoutPage.clickContinue();
        Thread.sleep(1000);

        // Checkout Overview
        String actualPageTitle =checkoutPage.getPageTitle();            
        if (actualPageTitle.equals("Checkout: Overview")) {
 
            System.out.println(" Checkout Overview page is displayed");

        }
        else {

            System.out.println(" Checkout Overview page is not displayed");
        }

        checkoutPage.clickFinish();
        Thread.sleep(1000);
        // Thank You Message
        String actualMessage =checkoutPage.getThankYouMessage();

        if (actualMessage.equals("Thank you for your order!")) {

            System.out.println("Thank you message is displayed");

        } else {

            System.out.println("Thank you message is not displayed");
        }

        System.out.println("Order Message: " + actualMessage);
        System.out.println("Order Placement Test Completed");
    }
}
